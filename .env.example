# Job AutoApply configuration
# Copy this file to .env and replace the example values with your own.
# Never commit .env or share your API keys/passwords.

# Personal profile used to tailor application forms and cover letters
NAME=Your Name
EMAIL=you@example.com
PHONE=+91 9999999999
LOCATION=City, Country
CURRENT_ROLE=Your Current Role
COMPANY=Your Company
EDUCATION=Your Degree, Your Institute
YEARS_EXPERIENCE=Your years of experience
SKILLS=Python, FastAPI, SQL, PostgreSQL
HIGHLIGHTS=First verified resume achievement||Second verified resume achievement

# Application answers
NOTICE_PERIOD=30 days
CURRENT_CTC=0
EXPECTED_CTC=0
DOB=
GENDER=Prefer not to say
WORK_AUTH=Authorized to work in my country of residence.

# Profile links
GITHUB_URL=https://github.com/yagnaraval
LINKEDIN_URL=https://www.linkedin.com/in/your-profile/
PORTFOLIO_URL=

# Optional: Google Gemini API key for unanswered application questions
GEMINI_KEY=
